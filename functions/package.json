    "groq-sdk": "^1.2.1",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0"
  },
  "private": true
}
